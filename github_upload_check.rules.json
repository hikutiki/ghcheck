{
  "_comment": "github_upload_check.py の検査規則。secret_patterns=FAIL、warn_patterns=WARN（止めない）。entropy=高エントロピー文字列のWARN閾値。項目を増やすときはここに追記する。regexはPython re構文。 downgrade_globs=一致するpathでは secret_patterns の FAIL を WARN に格下げ（テスト用ダミー鍵）。",
  "dangerous_names": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.keystore",
    "*.jks",
    "id_rsa",
    "id_rsa.*",
    "id_ed25519",
    "id_ed25519.*",
    "auth.json",
    "credentials.json",
    "credentials",
    "token.json",
    "tokens.json",
    "secrets.json",
    "secrets.yaml",
    "secrets.yml",
    "secret.*",
    "*cookie*",
    "*cookies*",
    "storage_state.json",
    ".clasp.json",
    ".npmrc",
    ".pypirc",
    ".netrc"
  ],
  "dangerous_warn": [
    "config.json",
    "state.json",
    "*.sqlite",
    "*.db"
  ],
  "secret_patterns": [
    {
      "label": "AWS access key",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "label": "GitHub token",
      "regex": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}\\b"
    },
    {
      "label": "GitHub fine-grained token",
      "regex": "github_pat_[A-Za-z0-9_]{20,}"
    },
    {
      "label": "OpenAI/Anthropic key",
      "regex": "\\bsk-(ant-)?[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "label": "Google API key",
      "regex": "AIza[0-9A-Za-z_-]{35}"
    },
    {
      "label": "Slack token",
      "regex": "xox[abpr]-[0-9A-Za-z-]{10,}"
    },
    {
      "label": "Notion secret",
      "regex": "\\b(secret|ntn)_[A-Za-z0-9]{30,}\\b"
    },
    {
      "label": "Private key block",
      "regex": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"
    },
    {
      "label": "Bearer token",
      "regex": "Bearer\\s+[A-Za-z0-9._-]{30,}"
    },
    {
      "label": "password/secret assignment",
      "regex": "(?i)\\b(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)\\b\\s*[:=]\\s*['\"][^'\"\\s]{8,}['\"]"
    },
    {
      "label": "Discord webhook",
      "regex": "discord(app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]+"
    },
    {
      "label": "LINE channel token",
      "regex": "(?i)channel[_-]?access[_-]?token\\s*[:=]\\s*['\"][A-Za-z0-9+/=]{40,}['\"]"
    },
    {
      "label": "Stripe key",
      "regex": "\\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{20,}\\b"
    },
    {
      "label": "SendGrid key",
      "regex": "\\bSG\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "label": "Twilio key",
      "regex": "\\b(SK|AC)[0-9a-f]{32}\\b"
    },
    {
      "label": "Hugging Face token",
      "regex": "\\bhf_[A-Za-z0-9]{30,}\\b"
    },
    {
      "label": "Groq key",
      "regex": "\\bgsk_[A-Za-z0-9]{40,}\\b"
    },
    {
      "label": "Perplexity key",
      "regex": "\\bpplx-[A-Za-z0-9]{40,}\\b"
    },
    {
      "label": "xAI key",
      "regex": "\\bxai-[A-Za-z0-9]{40,}\\b"
    },
    {
      "label": "Google OAuth client secret",
      "regex": "\\bGOCSPX-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "label": "JWT",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
    },
    {
      "label": "api key/token assignment (unquoted, .env形式)",
      "regex": "(?im)^\\s*(export\\s+)?[A-Z0-9_]*(API[_-]?KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_]*\\s*=\\s*[A-Za-z0-9_\\-./+]{16,}\\s*$"
    }
  ],
  "forbid_dirs": [],
  "skip_suffixes": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".pdf",
    ".zip",
    ".gz",
    ".tar",
    ".mp4",
    ".mov",
    ".wav",
    ".mp3",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf"
  ],
  "warn_patterns": [
    {
      "label": "32桁hex（MD5/鍵の疑い）",
      "regex": "(?<![0-9a-fA-F])[0-9a-fA-F]{32}(?![0-9a-fA-F])"
    },
    {
      "label": "40桁hex（SHA1/鍵の疑い）",
      "regex": "(?<![0-9a-fA-F])[0-9a-fA-F]{40}(?![0-9a-fA-F])"
    },
    {
      "label": "64桁hex（SHA256/鍵の疑い）",
      "regex": "(?<![0-9a-fA-F])[0-9a-fA-F]{64}(?![0-9a-fA-F])"
    },
    {
      "label": "base64風の長い文字列",
      "regex": "(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{60,}={0,2}(?![A-Za-z0-9+/=])"
    },
    {
      "label": "分割された鍵の疑い（接頭辞+連結）",
      "regex": "['\"](sk-|sk_live_|ghp_|AKIA|xox[abpr]-|hf_|AIza|Bearer )['\"]\\s*(\\+|,|\\.format|f['\"])"
    },
    {
      "label": "URL埋め込み認証情報",
      "regex": "[a-z][a-z0-9+.-]*://[^/\\s:@]+:[^/\\s:@]+@"
    },
    {
      "label": "key/secret/token を含む変数への代入",
      "regex": "(?i)\\b\\w*(api[_-]?key|secret|token|passw(or)?d)\\w*\\s*[:=]\\s*['\"][^'\"\\s]{6,}['\"]"
    }
  ],
  "entropy": {
    "min_len": 20,
    "threshold": 4.5,
    "charset": "[A-Za-z0-9_\\-+=]"
  },
  "ignore_line_keywords": [
    "sha256",
    "sha1",
    "sha-",
    "md5",
    "digest",
    "checksum",
    "integrity",
    "commit",
    "hash",
    "uuid",
    "guid",
    "objectname",
    "blob ",
    "fingerprint",
    "etag",
    "content-hash",
    "sessionid",
    "session_id",
    "trace",
    "request_id",
    "x-request",
    "nonce",
    "example",
    "your_",
    "your-",
    "test-token",
    "test-key",
    "placeholder",
    "dummy",
    "xxxxx",
    "/var/folders",
    "/tmp/",
    "notion.so",
    "notion.com",
    "revision",
    "class=",
    "jscontroller",
    "jsaction"
  ],
  "downgrade_globs": [
    "*/tests/*",
    "*/test/*",
    "*test_*.py",
    "*.test.js",
    "*.test.ts",
    "*_test.py",
    "*/fixtures/*"
  ]
}